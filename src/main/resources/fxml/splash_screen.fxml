<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.Image?>

<StackPane fx:id="rootPane" prefHeight="400.0" prefWidth="600.0" 
           styleClass="splash-root" 
           xmlns="http://javafx.com/javafx/17" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="org.reconan.controller.SplashScreenController">
   <children>
      <ImageView fx:id="logoView" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="logo-view">
         <image>
            <Image url="@../images/icon.png" />
         </image>
      </ImageView>
   </children>
</StackPane>
