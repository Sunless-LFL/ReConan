<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" styleClass="workspace-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.reconan.controller.InvestigationWorkspaceController">
    <top>
       <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="workspace-header" BorderPane.alignment="CENTER">
          <children>
             <Label fx:id="investigationNameLabel" styleClass="workspace-title" text="Investigation: Untitled" />
             <Pane HBox.hgrow="ALWAYS" />
             <Button mnemonicParsing="false" onAction="#handleBackToMenu" styleClass="action-button-secondary" text="Back to Menu" />
          </children>
          <padding>
             <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
          </padding>
       </HBox>
    </top>
   <center>
      <SplitPane dividerPositions="0.2, 0.8" prefHeight="160.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <items>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <Label styleClass="panel-title" text="Entity Palette" />
                  <ListView fx:id="entityPaletteList" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <StackPane fx:id="graphPane" prefHeight="200.0" prefWidth="200.0" styleClass="graph-pane">
               <children>
                  <VBox alignment="TOP_RIGHT" pickOnBounds="false" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleToggleLayout" styleClass="graph-overlay-button" text="Toggle Layout" />
                     </children>
                     <padding>
                        <Insets right="15.0" top="15.0" />
                     </padding>
                  </VBox>
               </children>
            </StackPane>
            <VBox prefHeight="200.0" prefWidth="250.0" spacing="15.0" styleClass="details-panel">
               <children>
                  <Label styleClass="panel-title" text="Entity Details" />
                  <VBox fx:id="detailsContainer" spacing="10.0" VBox.vgrow="ALWAYS" styleClass="properties-container">
                     <!-- Property labels will be added here dynamically -->
                  </VBox>
                  <VBox fx:id="actionPanel" spacing="10.0" styleClass="action-panel">
                     <children>
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleUpdateEntity" styleClass="action-button-secondary" text="Update Value" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDeleteEntity" styleClass="action-button-delete" text="Delete Entity" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
            </VBox>
        </items>
      </SplitPane>
   </center>
</BorderPane>
